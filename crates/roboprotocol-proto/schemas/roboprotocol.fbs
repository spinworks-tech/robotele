// RoboProtocol wire schema (DESIGN.md §1.2.2, §1.3.2, and this repo's v0
// Channel B frame design). Kept as a single .fbs file rather than split
// per-message: flatc's handling of multiple same-namespace schema files in
// one invocation wasn't verified against an installed `flatc` at the time
// this was written, so one file avoids an untested cross-file module-merge
// risk. Split later once that's been exercised for real, if desired.

namespace roboprotocol;

// ---------------------------------------------------------------------
// HELLO (DESIGN.md §1.2.2) -- Channel C stream 0.
// ---------------------------------------------------------------------

table TLV {
  tag: uint16;
  value: [ubyte];
}

table RoboProtocolHello {
  protocol_version: uint16;             // major<<8 | minor
  capability_bitmask: uint64;
  supported_task_classes: uint8;        // bit0=B,1=C,2=D,3=E
  supported_quantization_tiers: uint8;  // bit0=Full,1=Standard,2=Compact
  max_control_rate_hz: uint16;
  extensions: [TLV];
}

// ---------------------------------------------------------------------
// SESSION_DESCRIBE / SESSION_ACCEPT (DESIGN.md §1.3.2) -- Channel C stream 1.
// ---------------------------------------------------------------------

// DESIGN.md §5 specifies H.265/AV1 for Channel A. H264 is a documented v0
// deviation: it's what the CM4's BCM2711 hardware encoder (via
// libcamera/rpicam-vid) actually supports; H.265/AV1 hw encode isn't
// available on this SoC.
enum Codec : uint8 { H265, AV1, H264 }

table JointDescriptor {
  min_limit: float32;
  max_limit: float32;
  max_velocity: float32;
  has_torque_sensing: bool;
  region_id: uint8;
}

// FR-1.5 (REQUIREMENTS.md), DESIGN.md §1.3.2/§1.3.3: what a Channel B
// *command* datagram means for this region. Telemetry is always per-joint
// regardless of command_shape -- this enum governs command encoding only.
enum CommandShape : uint8 {
  Kinematic,            // one command field per joint in the region
  VelocityAttitude,     // fixed 7 fields, ONE shared block per robot (not
                         // per region -- body velocity isn't a per-leg
                         // quantity): vx, vy, turn, roll, pitch, yaw,
                         // action_id (discrete gait/preset trigger, 0=none)
  CartesianEndEffector, // fixed 4 fields per region: x, y, z, gripper
}

table BodyRegionDescriptor {
  region_id: uint8;
  name: string;               // debug/logging only, not used for wire offsets
  joint_start: uint16;
  joint_count: uint16;
  has_force_torque_sensor: bool;
  command_shape: CommandShape;
}

// FR-1.6, DESIGN.md §1.3.6: one whole-robot morphology fact, distinct from
// CommandShape (which is per-region). A hardware fact, not a negotiable
// capability -- travels in SessionDescribe, not the HELLO capability
// bitmask.
enum BaseType : uint8 {
  Stationary,       // fixed-base manipulator, no locomotion at all
  WheeledStandard,  // differential/Ackermann drive -- lateral motion not independently commandable
  WheeledHolonomic, // mecanum/omni wheels -- lateral motion independently commandable
  BipedLegs,        // 2 legs, dynamically balanced -- SR-1's WBC/ZMP override is load-bearing
  QuadrupedLegs,    // 4+ legs, statically stable -- SR-1's WBC/ZMP override is a documented no-op
  Other,            // a morphology not covered above (e.g. tracked, aerial)
}

table RobotProfile {
  dof_count: uint16;
  joints: [JointDescriptor];         // wire order == Channel B field order
  regions: [BodyRegionDescriptor];
  base_type: BaseType;
}

table CameraDescriptor {
  camera_id: uint8;
  label: string;
  codec: Codec;
  resolution_w: uint16;
  resolution_h: uint16;
  max_fps: uint8;
  min_bitrate_kbps: uint32;
  max_bitrate_kbps: uint32;
}

table SessionDescribe {
  robot_id: string;
  profile_hash: uint64;
  robot_profile: RobotProfile;
  cameras: [CameraDescriptor];
}

// category: 0=command, 1=telemetry, 2=haptic (matches ChannelBCategory below)
// tier: matches roboprotocol_core::sizing::QuantizationTier (1=Compact, 2=Standard, 4=Full)
table FieldQuantization {
  category: uint8;
  tier: uint8;
}

table SessionAccept {
  profile_hash: uint64;
  cached: bool;                       // true: operator already holds this profile (§1.3.4)
  selected_regions: [uint8];
  quantization: [FieldQuantization];  // FR-3.1 haptic floor still enforced by the console, not the wire
  selected_cameras: [uint8];
}

// ---------------------------------------------------------------------
// Channel B (DESIGN.md §2.2, §1.3.3) -- unreliable QUIC datagrams.
//
// A thin table wrapping one opaque packed-bytes vector for the actual
// quantized fields: literally "FlatBuffers over QUIC Datagrams" per the
// layered-protocol table, while the payload inside `fields` carries zero
// self-describing metadata -- satisfying §1.3.3's "no explicit register
// map" by deriving byte offsets from the negotiated RobotProfile instead
// (roboprotocol_core::profile::derive_layout) rather than a vtable per
// field, which would burn budget at 100Hz-1kHz for 40-50 DoF.
// ---------------------------------------------------------------------

enum ChannelBCategory : uint8 { Command, Telemetry, Haptic }

table ChannelBFrame {
  timestamp: uint64;      // roboprotocol_core::timestamp::Timestamp64
  seq: uint64;
  tick_id: uint32;
  category: ChannelBCategory;
  region_id: uint8;       // 0xFF = all regions (not split this datagram)
  fields: [ubyte];        // packed quantized values, offsets from derive_layout()
}

// ---------------------------------------------------------------------
// ActionTrigger (FR-1.8, DESIGN.md §2.2/§2.3) -- Channel C, client-initiated
// bidi stream 4 (next in the 0,4,8,... category after HELLO's stream 0).
//
// Discrete one-shot command triggers (e.g. a canned stand/sit gait) used
// to be packed into ChannelBFrame's VelocityAttitudeCommand alongside
// continuous vx/vy/turn fields, sharing their sequence-staleness gate --
// a genuine new trigger could be silently dropped along with a stale
// continuous update it happened to be batched with. Moved here instead:
// a reliable QUIC stream gives triggers delivery + ordering guarantees,
// which is what a one-shot event wants and what Channel B's continuous
// fields deliberately do NOT want.
// ---------------------------------------------------------------------

table ActionTrigger {
  action_id: uint8;
  trigger_seq: uint64;   // independent monotonic identity (FR-1.8) -- not
                          // the same sequence space as ChannelBFrame.seq
}

// ---------------------------------------------------------------------
// CameraControl -- Channel C, client-initiated bidi stream 8 (next in the
// 0,4,8,... category after ActionTrigger's stream 4).
//
// Image-quality tuning (brightness/contrast/exposure/shutter) for the
// `libcamera-vid` capture subprocess. Discrete "set and hold" state, same
// reasoning as ActionTrigger above -- NOT a per-tick continuous Channel B
// field, because applying a change means killing and restarting
// `libcamera-vid` with new args (it has no live-parameter-update
// interface of its own), so sending this every tick like
// VelocityAttitudeCommand would restart the capture process constantly.
// ---------------------------------------------------------------------

table CameraControl {
  brightness: float32;   // libcamera-vid --brightness, -1.0..1.0, default 0.0
  contrast: float32;     // libcamera-vid --contrast, clamped 0.0..2.0, default 1.0
  ev: float32;           // libcamera-vid --ev (exposure compensation, in
                          // stops), clamped -4.0..4.0, default 0.0
  shutter_us: uint32;    // libcamera-vid --shutter (manual exposure time,
                          // microseconds); 0 means auto-exposure (the flag
                          // is omitted entirely, not passed as 0)
  control_seq: uint64;   // independent monotonic identity, mirrors
                          // ActionTrigger.trigger_seq
}

// No `root_type` declared: this schema has six independent top-level
// message types (RoboProtocolHello, SessionDescribe, SessionAccept,
// ChannelBFrame, ActionTrigger, CameraControl), and `root_type` is a
// schema-wide setting in this flatc version -- only the last declaration
// would win, silently dropping the generated root-parse helper for the
// others. Every endpoint instead calls `flatbuffers::get_root::<T>(buf)`
// directly for whichever type it expects on a given stream/datagram.
