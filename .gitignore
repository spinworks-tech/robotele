/target/
# Dev-only demo certs are tracked (see certs/README.md) so a quick demo
# needs no cert setup -- but never the CA's own private key, which would
# let anyone mint additional certs these processes trust.
/certs/*
!/certs/dev-ca
/certs/dev-ca/ca.key
!/certs/dev-ca/ca.crt
!/certs/robot
!/certs/robot/robot.crt
!/certs/robot/robot.key
!/certs/operator
!/certs/operator/operator.crt
!/certs/operator/operator.key
!/certs/README.md
# Private per-machine runtime state (0-RTT session tickets, local profile-
# cache records) -- not demo certs, never shared/committed.
/.session-cache/
*.pem.bak
__pycache__/
*.pyc
.pytest_cache/
# Local recording output (FR-9, roboprotocol-recording) and operator-console's
# own runtime log -- generated by running the binaries, not source.
/recordings/
operator-console.log
